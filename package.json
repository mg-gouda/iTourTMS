{
  "name": "itour-tms",
  "version": "1.0.0",
  "private": true,
  "description": "iTourTMS — Enterprise Travel Management System",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' sh -c 'prisma generate && next build'",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/seed-setup.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "license:generate": "tsx scripts/generate-license-key.ts",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:finance": "playwright test e2e/finance",
    "test:e2e:contracting": "playwright test e2e/contracting",
    "test:e2e:crm": "playwright test e2e/crm",
    "test:e2e:reservations": "playwright test e2e/reservations",
    "test:e2e:traffic": "playwright test e2e/traffic",
    "test:e2e:b2b": "playwright test e2e/b2b",
    "test:e2e:b2c": "playwright test e2e/b2c",
    "help:screenshots": "tsx --env-file=.env scripts/capture-help-screenshots.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "overrides": {
      "minimatch": "^10.2.5",
      "flatted": "^3.4.2",
      "hono": "^4.12.34",
      "@hono/node-server": "^1.19.15",
      "express-rate-limit": "^8.5.1",
      "effect": "^3.21.2",
      "defu": "^6.1.7",
      "lodash": "^4.18.1",
      "vite": "^7.3.6",
